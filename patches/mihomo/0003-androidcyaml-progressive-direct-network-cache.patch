+package dns
+
+import (
+	"testing"
+
+	D "github.com/miekg/dns"
+)
+
+func TestDirectCacheKeySeparatesNetworkEnvironments(t *testing.T) {
+	question := D.Question{Name: "example.test.", Qtype: D.TypeA, Qclass: D.ClassINET}
+	wifiHome := directCacheKey("environment|wifi-home", question)
+	wifiOffice := directCacheKey("environment|wifi-office", question)
+	mobileOne := directCacheKey("environment|mobile-sim-1", question)
+	mobileTwo := directCacheKey("environment|mobile-sim-2", question)
+	keys := map[string]struct{}{
+		wifiHome: {}, wifiOffice: {}, mobileOne: {}, mobileTwo: {},
+	}
+	if len(keys) != 4 {
+		t.Fatalf("network-scoped cache keys collided: %q %q %q %q", wifiHome, wifiOffice, mobileOne, mobileTwo)
+	}
+}
