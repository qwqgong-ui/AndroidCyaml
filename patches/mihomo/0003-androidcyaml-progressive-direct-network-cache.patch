+package dialer
+
+import (
+	"net/netip"
+	"testing"
+)
+
+func TestDirectNetworkScopePrefersPlatformEnvironment(t *testing.T) {
+	SetDirectNetworkEnvironment("wifi-fingerprint")
+	t.Cleanup(func() { SetDirectNetworkEnvironment("") })
+	if got := directNetworkScope(option{interfaceName: "ignored"}); got != "environment|wifi-fingerprint" {
+		t.Fatalf("direct network scope = %q", got)
+	}
+}
+
+func TestDirectNetworkScopeUsesPrivate16Boundary(t *testing.T) {
+	first := scopeForPrefixes("wlan0", []netip.Prefix{netip.MustParsePrefix("192.168.12.34/24")})
+	second := scopeForPrefixes("wlan0", []netip.Prefix{netip.MustParsePrefix("192.168.99.8/24")})
+	other := scopeForPrefixes("wlan0", []netip.Prefix{netip.MustParsePrefix("192.169.1.8/24")})
+	if first != "wlan0|192.168.0.0/16" || second != first || other == first {
+		t.Fatalf("network scopes first=%q second=%q other=%q", first, second, other)
+	}
+}
