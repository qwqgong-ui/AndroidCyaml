diff --git a/component/dialer/direct_race_gate_test.go b/component/dialer/direct_race_gate_test.go
new file mode 100644
index 00000000..8f7632b0
--- /dev/null
+++ b/component/dialer/direct_race_gate_test.go
@@ -0,0 +1,86 @@
+package dialer
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"testing"
+	"time"
+)
+
+// directRaceAttempts counts how many TCP connects a single DIRECT-style dial
+// starts against a hostname with two unresponsive A records. Every candidate
+// blocks forever, so whatever has started by the time we look is exactly what
+// the dialer chose to have in flight at once.
+func directRaceAttempts(t *testing.T, raceEnabled bool) int {
+	t.Helper()
+
+	first := netip.MustParseAddr("198.51.100.10")
+	second := netip.MustParseAddr("198.51.100.11")
+
+	hang := make(chan struct{})
+	dial := &controlledDialer{
+		attempts: make(chan netip.Addr, 8),
+		behaviors: map[netip.Addr]connectBehavior{
+			first:  {gate: hang, err: errors.New("blackhole")},
+			second: {gate: hang, err: errors.New("blackhole")},
+		},
+	}
+	lookup := &controlledLookup{
+		v4Gate:  closedGate(),
+		v6Gate:  closedGate(),
+		v4:      []netip.Addr{first, second},
+		timeout: 50 * time.Millisecond,
+	}
+
+	options := []Option{WithResolver(lookup), WithNetDialer(dial)}
+	if raceEnabled {
+		options = append(options, WithDirectDualStack())
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	finished := make(chan struct{})
+	go func() {
+		conn, _ := DialContext(ctx, "tcp", "example.test:443", options...)
+		if conn != nil {
+			_ = conn.Close()
+		}
+		close(finished)
+	}()
+
+	// Long enough for every candidate the dialer intends to start in parallel
+	// to have started, and for the IPv6 wait budget above to expire.
+	time.Sleep(200 * time.Millisecond)
+	started := len(dial.attempts)
+
+	cancel()
+	close(hang)
+	<-finished
+	return started
+}
+
+// TestDirectRaceGateStartsOneCandidateAtATime is the fan-out this gate exists to
+// stop. With the race on, both A records are dialed at the same instant, so a
+// hostname that does not answer costs one socket per address for the whole dial
+// timeout. With it off, DIRECT walks the candidates one at a time.
+func TestDirectRaceGateStartsOneCandidateAtATime(t *testing.T) {
+	if started := directRaceAttempts(t, false); started != 1 {
+		t.Fatalf("DIRECT started %d simultaneous connects with the race disabled, want 1", started)
+	}
+}
+
+// TestDirectRaceStillFansOutWhenEnabled pins the behaviour the gate suppresses,
+// so this pair keeps meaning something if the racing code changes.
+func TestDirectRaceStillFansOutWhenEnabled(t *testing.T) {
+	if started := directRaceAttempts(t, true); started != 2 {
+		t.Fatalf("DIRECT race started %d simultaneous connects, want 2", started)
+	}
+}
+
+// TestDirectRaceDefaultsOff records the shipped default. The race is only worth
+// re-enabling once it delays its candidates instead of starting them together.
+func TestDirectRaceDefaultsOff(t *testing.T) {
+	if DirectRaceEnabled {
+		t.Fatal("DirectRaceEnabled defaults to true; DIRECT will fan out on every dial")
+	}
+}
