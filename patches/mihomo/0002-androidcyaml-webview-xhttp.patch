diff --git a/transport/xhttp/browser_transport.go b/transport/xhttp/browser_transport.go
new file mode 100644
index 0000000..6451941
--- /dev/null
+++ b/transport/xhttp/browser_transport.go
@@ -0,0 +1,88 @@
+package xhttp
+
+import (
+	"errors"
+	"strings"
+	"sync"
+
+	"github.com/metacubex/http"
+)
+
+// BrowserTransportOptions identifies the original proxy endpoint and the URL
+// host used by XHTTP. Android may use ServerAddress for endpoint pinning while
+// preserving Host as the browser-visible origin and TLS server name.
+type BrowserTransportOptions struct {
+	ServerAddress string
+	Host          string
+}
+
+// BrowserTransportFactory is installed by an embedding application. Returning
+// a RoundTripper keeps the XHTTP framing/session implementation inside mihomo
+// while moving TLS and HTTP request generation into the platform browser.
+type BrowserTransportFactory func(BrowserTransportOptions) (http.RoundTripper, error)
+
+var (
+	browserTransportMu      sync.RWMutex
+	browserTransportFactory BrowserTransportFactory
+)
+
+func SetBrowserTransportFactory(factory BrowserTransportFactory) {
+	browserTransportMu.Lock()
+	browserTransportFactory = factory
+	browserTransportMu.Unlock()
+}
+
+func BrowserTransportEnabled() bool {
+	browserTransportMu.RLock()
+	enabled := browserTransportFactory != nil
+	browserTransportMu.RUnlock()
+	return enabled
+}
+
+func NewBrowserTransport(options BrowserTransportOptions) (http.RoundTripper, error) {
+	browserTransportMu.RLock()
+	factory := browserTransportFactory
+	browserTransportMu.RUnlock()
+	if factory == nil {
+		return nil, errors.New("xhttp browser transport is not installed")
+	}
+	return factory(options)
+}
+
+type browserErrorTransport struct {
+	err error
+}
+
+func (t browserErrorTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, t.err
+}
+
+func BrowserTransportMaker(options BrowserTransportOptions) TransportMaker {
+	return func() http.RoundTripper {
+		transport, err := NewBrowserTransport(options)
+		if err != nil {
+			return browserErrorTransport{err: err}
+		}
+		return transport
+	}
+}
+
+func PrepareBrowserConfig(config *Config) error {
+	if config == nil {
+		return errors.New("xhttp browser transport received nil config")
+	}
+	if config.GetNormalizedSessionPlacement() == PlacementCookie ||
+		config.GetNormalizedSeqPlacement() == PlacementCookie ||
+		config.XPaddingPlacement == PlacementCookie ||
+		config.GetNormalizedUplinkDataPlacement() == PlacementCookie {
+		return errors.New("xhttp WebView transport does not support cookie placement")
+	}
+	for name := range config.Headers {
+		if strings.EqualFold(name, "Cookie") {
+			return errors.New("xhttp WebView transport does not support custom Cookie headers")
+		}
+	}
+	config.Mode = "packet-up"
+	config.ReuseConfig = nil
+	return nil
+}

diff --git a/transport/xhttp/browser_transport_test.go b/transport/xhttp/browser_transport_test.go
new file mode 100644
index 0000000..6d8f323
--- /dev/null
+++ b/transport/xhttp/browser_transport_test.go
@@ -0,0 +1,91 @@
+package xhttp
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/metacubex/http"
+)
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(request *http.Request) (*http.Response, error) {
+	return f(request)
+}
+
+func TestBrowserTransportFactory(t *testing.T) {
+	SetBrowserTransportFactory(nil)
+	t.Cleanup(func() { SetBrowserTransportFactory(nil) })
+
+	if BrowserTransportEnabled() {
+		t.Fatal("browser transport unexpectedly enabled")
+	}
+	if _, err := NewBrowserTransport(BrowserTransportOptions{}); err == nil {
+		t.Fatal("NewBrowserTransport succeeded without a factory")
+	}
+
+	wantErr := errors.New("browser request reached test transport")
+	wantOptions := BrowserTransportOptions{
+		ServerAddress: "203.0.113.10:443",
+		Host:          "example.com",
+	}
+	SetBrowserTransportFactory(func(options BrowserTransportOptions) (http.RoundTripper, error) {
+		if options != wantOptions {
+			t.Fatalf("options = %#v, want %#v", options, wantOptions)
+		}
+		return roundTripFunc(func(*http.Request) (*http.Response, error) {
+			return nil, wantErr
+		}), nil
+	})
+
+	if !BrowserTransportEnabled() {
+		t.Fatal("browser transport not enabled after factory install")
+	}
+	transport := BrowserTransportMaker(wantOptions)()
+	request, err := http.NewRequest(http.MethodGet, "https://example.com/test", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = transport.RoundTrip(request); !errors.Is(err, wantErr) {
+		t.Fatalf("RoundTrip error = %v, want %v", err, wantErr)
+	}
+}
+
+func TestPrepareBrowserConfig(t *testing.T) {
+	config := &Config{
+		Mode:              "stream-one",
+		SessionPlacement:  PlacementQuery,
+		SeqPlacement:      PlacementQuery,
+		XPaddingPlacement: PlacementQueryInHeader,
+		ReuseConfig:       &ReuseConfig{},
+	}
+	if err := PrepareBrowserConfig(config); err != nil {
+		t.Fatal(err)
+	}
+	if config.Mode != "packet-up" {
+		t.Fatalf("mode = %q, want packet-up", config.Mode)
+	}
+	if config.ReuseConfig != nil {
+		t.Fatal("browser config retained XMUX reuse settings")
+	}
+
+	for name, mutate := range map[string]func(*Config){
+		"session":     func(c *Config) { c.SessionPlacement = PlacementCookie },
+		"seq":         func(c *Config) { c.SeqPlacement = PlacementCookie },
+		"padding":     func(c *Config) { c.XPaddingPlacement = PlacementCookie },
+		"uplink-data": func(c *Config) { c.UplinkDataPlacement = PlacementCookie },
+		"header":      func(c *Config) { c.Headers = map[string]string{"Cookie": "x=y"} },
+	} {
+		t.Run(name, func(t *testing.T) {
+			candidate := &Config{
+				SessionPlacement:  PlacementQuery,
+				SeqPlacement:      PlacementQuery,
+				XPaddingPlacement: PlacementQueryInHeader,
+			}
+			mutate(candidate)
+			if err := PrepareBrowserConfig(candidate); err == nil {
+				t.Fatal("cookie-based config unexpectedly accepted")
+			}
+		})
+	}
+}
