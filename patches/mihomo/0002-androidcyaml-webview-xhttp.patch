 transport/xhttp/browser_transport.go      | 108 +++++++++++++++++++++
 transport/xhttp/browser_transport_test.go | 122 ++++++++++++++++++++++++
 3 files changed, 255 insertions(+)
 create mode 100644 transport/xhttp/browser_transport.go
 create mode 100644 transport/xhttp/browser_transport_test.go

