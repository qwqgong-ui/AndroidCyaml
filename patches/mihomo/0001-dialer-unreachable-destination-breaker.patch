diff --git a/component/dialer/unreachable.go b/component/dialer/unreachable.go
new file mode 100644
index 00000000..07edca79
--- /dev/null
+++ b/component/dialer/unreachable.go
@@ -0,0 +1,220 @@
+package dialer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"sync"
+	"syscall"
+	"time"
+)
+
+// A blackholed destination is the expensive kind of failure. It does not answer
+// and it does not refuse: the SYN goes out, nothing comes back, and the dial
+// occupies a socket, a goroutine and a tracker entry for the whole dial timeout.
+//
+// One of those is nothing. What makes it a storm is that the client above the
+// tunnel cannot tell the destination is dead either. A TUN completes the local
+// handshake immediately -- measured on Android at 1.2ms against an address that
+// is not routable anywhere -- so connect() succeeds, the client believes it has
+// a connection, and only discovers otherwise when the dial times out five
+// seconds later. Its own health checking is blinded, so it opens more. Against
+// one peer-to-peer CDN hostname that resolves to two dead peers, that produced
+// 470 simultaneous half-open sockets.
+//
+// This is an ordinary circuit breaker over that. After a few consecutive
+// reachability failures a destination is tripped, and further dials to it fail
+// immediately instead of waiting out the timeout again. After the cooldown one
+// probe is let through; if it succeeds the destination is forgotten, and if it
+// fails the breaker re-arms. The client keeps retrying either way -- that is its
+// decision to make -- but a retry now costs a map lookup rather than a socket.
+//
+// Scoping is what makes this safe across a handover: the key carries the current
+// network environment, so the moment the platform reports a new path every
+// verdict recorded on the old one stops matching. Nothing has to be cleared and
+// no destination inherits a judgement made about a network it was never tried on.
+
+var (
+	// UnreachableBreakerThreshold is how many consecutive reachability failures
+	// trip a destination. Above one so a single lost SYN or a server restarting
+	// mid-dial does not trip anything. Zero or less disables the breaker.
+	UnreachableBreakerThreshold = 3
+
+	// UnreachableBreakerCooldown is how long a tripped destination keeps failing
+	// fast before one probe is allowed through. Short enough that a route
+	// recovering is noticed quickly, long enough that a client in a tight retry
+	// loop is not still paying for probes.
+	UnreachableBreakerCooldown = 30 * time.Second
+
+	// unreachableBreakerCapacity bounds the table. A breaker that grows without
+	// limit trades one leak for another, and the entries worth keeping are the
+	// few addresses being hammered, not the long tail dialed once.
+	unreachableBreakerCapacity = 4096
+)
+
+// ErrDestinationUnreachable reports a dial refused by the breaker rather than
+// attempted. It wraps the failure that tripped it, so the caller and the logs
+// still say what actually went wrong with the route.
+var ErrDestinationUnreachable = errors.New("destination is failing on this network")
+
+type unreachableEntry struct {
+	failures int
+	until    time.Time
+	cause    error
+	seen     time.Time
+}
+
+type unreachableBreaker struct {
+	mu      sync.Mutex
+	entries map[string]*unreachableEntry
+}
+
+var unreachableDestinations = &unreachableBreaker{entries: make(map[string]*unreachableEntry)}
+
+// unreachableKey binds a verdict to the path it was observed on. Two networks
+// disagree about which addresses are reachable far more often than they agree,
+// which is the whole reason a handover produces this failure mode.
+func unreachableKey(network, address string) string {
+	return directNetworkEnvironment.Load() + "\x00" + network + "\x00" + address
+}
+
+// blocked reports the error a tripped destination should fail with, or nil when
+// the dial may proceed. The probe that follows a cooldown is allowed through by
+// re-arming the window, so exactly one caller pays for it.
+func (b *unreachableBreaker) blocked(key string, now time.Time) error {
+	if UnreachableBreakerThreshold <= 0 {
+		return nil
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	entry, ok := b.entries[key]
+	if !ok || entry.failures < UnreachableBreakerThreshold {
+		return nil
+	}
+	if now.Before(entry.until) {
+		return fmt.Errorf("%w: %w", ErrDestinationUnreachable, entry.cause)
+	}
+	// Cooldown elapsed. Let this caller probe, and re-arm the window so the
+	// callers arriving behind it keep failing fast until the probe reports back.
+	entry.until = now.Add(UnreachableBreakerCooldown)
+	entry.seen = now
+	return nil
+}
+
+// succeeded forgets a destination that answered.
+func (b *unreachableBreaker) succeeded(key string) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	delete(b.entries, key)
+}
+
+// failed records one reachability failure.
+func (b *unreachableBreaker) failed(key string, cause error, now time.Time) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	entry, ok := b.entries[key]
+	if !ok {
+		if len(b.entries) >= unreachableBreakerCapacity {
+			b.evictLocked(now)
+		}
+		entry = &unreachableEntry{}
+		b.entries[key] = entry
+	}
+	entry.failures++
+	entry.cause = cause
+	entry.seen = now
+	if entry.failures >= UnreachableBreakerThreshold {
+		entry.until = now.Add(UnreachableBreakerCooldown)
+	}
+}
+
+// evictLocked drops entries nothing is consulting any more, and if that is not
+// enough, the least recently seen ones. Called only when the table is full.
+func (b *unreachableBreaker) evictLocked(now time.Time) {
+	stale := now.Add(-2 * UnreachableBreakerCooldown)
+	for key, entry := range b.entries {
+		if entry.seen.Before(stale) {
+			delete(b.entries, key)
+		}
+	}
+	for len(b.entries) >= unreachableBreakerCapacity {
+		oldestKey := ""
+		var oldest time.Time
+		for key, entry := range b.entries {
+			if oldestKey == "" || entry.seen.Before(oldest) {
+				oldestKey, oldest = key, entry.seen
+			}
+		}
+		if oldestKey == "" {
+			return
+		}
+		delete(b.entries, oldestKey)
+	}
+}
+
+// ClearUnreachableCache drops every recorded verdict. Scoped keys already make a
+// handover harmless, so this is for the cases that are not a handover -- a
+// config reload, or a caller that wants the next dial to be tried for real.
+func ClearUnreachableCache() {
+	unreachableDestinations.mu.Lock()
+	defer unreachableDestinations.mu.Unlock()
+	clear(unreachableDestinations.entries)
+}
+
+// isReachabilityFailure separates "this route does not work" from every other
+// reason a dial ends, because only the former is worth remembering.
+//
+// The distinction that matters is cost. A timeout or an unreachable route burned
+// the full dial budget and will burn it again. A refusal came back immediately,
+// costs nothing to retry, and usually means the host is alive and a service is
+// not -- tripping on that would fail dials the client could have made. A
+// cancelled context is not a verdict about the destination at all: it is the
+// caller leaving, which is exactly what the losing branches of a concurrent dial
+// do on every single successful connection.
+func isReachabilityFailure(ctx context.Context, err error) bool {
+	if err == nil {
+		return false
+	}
+	if ctx.Err() != nil && errors.Is(ctx.Err(), context.Canceled) {
+		return false
+	}
+	if errors.Is(err, context.Canceled) {
+		return false
+	}
+	if errors.Is(err, context.DeadlineExceeded) || errors.Is(err, os.ErrDeadlineExceeded) {
+		return true
+	}
+	if errors.Is(err, syscall.ETIMEDOUT) ||
+		errors.Is(err, syscall.EHOSTUNREACH) ||
+		errors.Is(err, syscall.ENETUNREACH) ||
+		errors.Is(err, syscall.EHOSTDOWN) ||
+		errors.Is(err, syscall.ENETDOWN) {
+		return true
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) && netErr.Timeout() {
+		return true
+	}
+	return false
+}
+
+// dialThroughBreaker is the funnel the plain TCP dial path passes through.
+func dialThroughBreaker(ctx context.Context, dialer *net.Dialer, network, address string) (net.Conn, error) {
+	key := unreachableKey(network, address)
+	if err := unreachableDestinations.blocked(key, time.Now()); err != nil {
+		return nil, err
+	}
+
+	conn, err := dialer.DialContext(ctx, network, address)
+	switch {
+	case err == nil:
+		unreachableDestinations.succeeded(key)
+	case isReachabilityFailure(ctx, err):
+		unreachableDestinations.failed(key, err, time.Now())
+	}
+	return conn, err
+}
diff --git a/component/dialer/unreachable_test.go b/component/dialer/unreachable_test.go
new file mode 100644
index 00000000..c5bc2e55
--- /dev/null
+++ b/component/dialer/unreachable_test.go
@@ -0,0 +1,207 @@
+package dialer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func resetBreaker(t *testing.T) {
+	t.Helper()
+	ClearUnreachableCache()
+	SetDirectNetworkEnvironment("")
+	threshold, cooldown := UnreachableBreakerThreshold, UnreachableBreakerCooldown
+	t.Cleanup(func() {
+		UnreachableBreakerThreshold, UnreachableBreakerCooldown = threshold, cooldown
+		ClearUnreachableCache()
+		SetDirectNetworkEnvironment("")
+	})
+}
+
+func timeoutErr() error {
+	return &net.OpError{Op: "dial", Err: syscall.ETIMEDOUT}
+}
+
+// TestBreakerTripsAfterThreshold is the storm: the same blackholed address is
+// dialed over and over, and after the threshold the dials stop costing sockets.
+func TestBreakerTripsAfterThreshold(t *testing.T) {
+	resetBreaker(t)
+	UnreachableBreakerThreshold = 3
+	UnreachableBreakerCooldown = time.Minute
+
+	key := unreachableKey("tcp4", "180.163.55.94:80")
+	now := time.Now()
+
+	for attempt := 1; attempt < UnreachableBreakerThreshold; attempt++ {
+		unreachableDestinations.failed(key, timeoutErr(), now)
+		if err := unreachableDestinations.blocked(key, now); err != nil {
+			t.Fatalf("tripped after %d failures, want %d", attempt, UnreachableBreakerThreshold)
+		}
+	}
+
+	unreachableDestinations.failed(key, timeoutErr(), now)
+	err := unreachableDestinations.blocked(key, now)
+	if err == nil {
+		t.Fatal("breaker did not trip at the threshold")
+	}
+	if !errors.Is(err, ErrDestinationUnreachable) {
+		t.Fatalf("error %v does not wrap ErrDestinationUnreachable", err)
+	}
+	if !errors.Is(err, syscall.ETIMEDOUT) {
+		t.Fatalf("error %v lost the cause that tripped it", err)
+	}
+}
+
+// TestBreakerAllowsOneProbePerCooldown keeps the breaker from becoming a
+// blackhole of its own: a route that comes back has to be discoverable.
+func TestBreakerAllowsOneProbePerCooldown(t *testing.T) {
+	resetBreaker(t)
+	UnreachableBreakerThreshold = 2
+	UnreachableBreakerCooldown = 30 * time.Second
+
+	key := unreachableKey("tcp4", "203.0.113.9:443")
+	start := time.Now()
+	unreachableDestinations.failed(key, timeoutErr(), start)
+	unreachableDestinations.failed(key, timeoutErr(), start)
+
+	if unreachableDestinations.blocked(key, start.Add(time.Second)) == nil {
+		t.Fatal("dial during the cooldown was not blocked")
+	}
+
+	afterCooldown := start.Add(UnreachableBreakerCooldown + time.Second)
+	if err := unreachableDestinations.blocked(key, afterCooldown); err != nil {
+		t.Fatalf("probe after the cooldown was blocked: %v", err)
+	}
+	// Only that one caller probes; everyone behind it keeps failing fast.
+	if unreachableDestinations.blocked(key, afterCooldown) == nil {
+		t.Fatal("a second caller was let through with the probe")
+	}
+
+	unreachableDestinations.succeeded(key)
+	if err := unreachableDestinations.blocked(key, afterCooldown); err != nil {
+		t.Fatalf("destination stayed tripped after a success: %v", err)
+	}
+}
+
+// TestBreakerVerdictsAreScopedToTheNetwork is the handover case. A verdict
+// recorded on Wi-Fi must not block the first dial made on cellular.
+func TestBreakerVerdictsAreScopedToTheNetwork(t *testing.T) {
+	resetBreaker(t)
+	UnreachableBreakerThreshold = 2
+	UnreachableBreakerCooldown = time.Minute
+
+	SetDirectNetworkEnvironment("wifi-fingerprint")
+	wifiKey := unreachableKey("tcp4", "180.163.55.94:80")
+	now := time.Now()
+	unreachableDestinations.failed(wifiKey, timeoutErr(), now)
+	unreachableDestinations.failed(wifiKey, timeoutErr(), now)
+	if unreachableDestinations.blocked(wifiKey, now) == nil {
+		t.Fatal("breaker did not trip on the first network")
+	}
+
+	SetDirectNetworkEnvironment("cellular-fingerprint")
+	cellularKey := unreachableKey("tcp4", "180.163.55.94:80")
+	if cellularKey == wifiKey {
+		t.Fatal("the key did not change with the network environment")
+	}
+	if err := unreachableDestinations.blocked(cellularKey, now); err != nil {
+		t.Fatalf("a verdict from the old network blocked the new one: %v", err)
+	}
+}
+
+// TestOnlyReachabilityFailuresCount guards the discrimination the breaker
+// depends on. Tripping on a refusal or on a cancelled concurrent dial would
+// fail connections that had nothing wrong with them.
+func TestOnlyReachabilityFailuresCount(t *testing.T) {
+	background := context.Background()
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	cases := []struct {
+		name string
+		ctx  context.Context
+		err  error
+		want bool
+	}{
+		{"timeout", background, &net.OpError{Op: "dial", Err: syscall.ETIMEDOUT}, true},
+		{"host unreachable", background, &net.OpError{Op: "dial", Err: syscall.EHOSTUNREACH}, true},
+		{"net unreachable", background, &net.OpError{Op: "dial", Err: syscall.ENETUNREACH}, true},
+		{"deadline exceeded", background, context.DeadlineExceeded, true},
+		{"refused", background, &net.OpError{Op: "dial", Err: syscall.ECONNREFUSED}, false},
+		{"reset", background, &net.OpError{Op: "dial", Err: syscall.ECONNRESET}, false},
+		{"caller cancelled", cancelled, context.Canceled, false},
+		{"losing concurrent dial", cancelled, &net.OpError{Op: "dial", Err: context.Canceled}, false},
+		{"success", background, nil, false},
+	}
+
+	for _, testCase := range cases {
+		t.Run(testCase.name, func(t *testing.T) {
+			if got := isReachabilityFailure(testCase.ctx, testCase.err); got != testCase.want {
+				t.Fatalf("isReachabilityFailure(%v) = %v, want %v", testCase.err, got, testCase.want)
+			}
+		})
+	}
+}
+
+// TestBreakerFailsFastEndToEnd measures the point of the change: a tripped
+// destination must cost nothing, not a dial timeout.
+func TestBreakerFailsFastEndToEnd(t *testing.T) {
+	resetBreaker(t)
+	UnreachableBreakerThreshold = 1
+	UnreachableBreakerCooldown = time.Minute
+
+	// 203.0.113.0/24 is TEST-NET-3: reserved for documentation and not routed,
+	// which is as close to a blackhole as a test can portably ask for.
+	const address = "203.0.113.201:80"
+	dialer := &net.Dialer{}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 300*time.Millisecond)
+	defer cancel()
+	if _, err := dialThroughBreaker(ctx, dialer, "tcp4", address); err == nil {
+		t.Skip("TEST-NET-3 answered; this network cannot host the test")
+	}
+
+	if err := unreachableDestinations.blocked(unreachableKey("tcp4", address), time.Now()); err == nil {
+		t.Skip("the first dial did not fail as a reachability failure on this host")
+	}
+
+	start := time.Now()
+	secondCtx, secondCancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer secondCancel()
+	_, err := dialThroughBreaker(secondCtx, dialer, "tcp4", address)
+	elapsed := time.Since(start)
+
+	if err == nil {
+		t.Fatal("tripped destination dialed successfully")
+	}
+	if !errors.Is(err, ErrDestinationUnreachable) {
+		t.Fatalf("second dial was attempted for real: %v", err)
+	}
+	if elapsed > 50*time.Millisecond {
+		t.Fatalf("tripped dial took %v; it should not have touched the network", elapsed)
+	}
+}
+
+// TestBreakerTableStaysBounded keeps the fix from trading one leak for another.
+func TestBreakerTableStaysBounded(t *testing.T) {
+	resetBreaker(t)
+	UnreachableBreakerThreshold = 1
+	UnreachableBreakerCooldown = time.Minute
+
+	now := time.Now()
+	for index := range unreachableBreakerCapacity * 2 {
+		key := unreachableKey("tcp4", fmt.Sprintf("198.51.100.1:%d", index))
+		unreachableDestinations.failed(key, timeoutErr(), now)
+	}
+
+	unreachableDestinations.mu.Lock()
+	size := len(unreachableDestinations.entries)
+	unreachableDestinations.mu.Unlock()
+	if size > unreachableBreakerCapacity {
+		t.Fatalf("breaker table holds %d entries, cap is %d", size, unreachableBreakerCapacity)
+	}
+}
