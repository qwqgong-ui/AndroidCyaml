<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/vpn_bar_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/top_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/runtime_info"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/on_top_bar"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vpn_status"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:maxWidth="132dp"
            android:text="@string/vpn_stopped"
            android:textColor="@color/on_top_bar"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/vpn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:contentDescription="@string/vpn_switch"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

        <TextView
            android:id="@+id/more_actions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/more_actions_background"
            android:clickable="true"
            android:contentDescription="@string/more_actions"
            android:focusable="true"
            android:gravity="center"
            android:padding="0dp"
            android:text="@string/more_actions_symbol"
            android:textColor="@color/on_top_bar"
            android:textSize="24sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/dashboard_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
